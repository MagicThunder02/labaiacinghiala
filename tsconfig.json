{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "svelte"]
  },
  "include": [
    "public/_modern/**/*.ts",
    "public/_modern/**/*.svelte",
    "frontend-tests/**/*.ts",
    "shared/**/*.d.ts",
    "shared/**/*.js",
    "src/types/**/*.d.ts",
    "vite.config.ts",
    "vitest.config.mts"
  ],
  "exclude": ["dist", "node_modules", "src-tauri/target", "host-connector/target"]
}
