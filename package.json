{
  "name": "cinema-amici",
  "version": "0.5.0",
  "private": true,
  "description": "Media server domestico modulare con Node.js, Express, SQLite e frontend HTML a pagine.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:frontend": "vite --config vite.config.ts",
    "build": "npm run typecheck && npm run build:frontend",
    "build:frontend": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json",
    "check": "npm run typecheck && npm test",
    "scan": "node src/scan-once.js",
    "test": "node scripts/run-test-suites.js test:backend test:frontend",
    "test:backend": "node --test",
    "test:frontend": "vitest run --config vitest.config.mts",
    "test:frontend:watch": "vitest --config vitest.config.mts",
    "test:frontend:coverage": "vitest run --coverage --config vitest.config.mts",
    "test:rust": "npm run test:rust:connector && npm run test:rust:tauri",
    "test:rust:connector": "cargo test --locked --manifest-path host-connector/Cargo.toml",
    "test:rust:tauri": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:all": "node scripts/run-test-suites.js typecheck test:backend test:frontend test:rust:connector test:rust:tauri",
    "tauri": "tauri",
    "pairing": "node src/pairing-admin.js",
    "prepare": "node scripts/copy-pdfjs-assets.js",
    "storage:migrate": "node scripts/storage-migrate.js",
    "connector:test": "cargo test --locked --manifest-path host-connector/Cargo.toml",
    "connector:build": "cargo build --locked --release --manifest-path host-connector/Cargo.toml",
    "connector:run": "cargo run --locked --manifest-path host-connector/Cargo.toml"
  },
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mime-types": "^3.0.2",
    "multer": "^2.4.0",
    "pdfjs-dist": "5.4.149",
    "taglib-wasm": "1.6.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
