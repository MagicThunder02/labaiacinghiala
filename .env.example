# Server HTTP
HOST=127.0.0.1
PORT=3000

# Radice della libreria. Se questo percorso è configurato esplicitamente,
# deve essere già raggiungibile all'avvio; il server creerà solo le sottocartelle gestite.
# Windows: R:\Media
# Linux: /mnt/raid/Media
LIBRARY_PATH=./media

# Database SQLite
DATABASE_PATH=./data/media.sqlite

# Verifica all'avvio che i file già registrati in SQLite esistano ancora.
# Non importa file copiati manualmente nella libreria.
VERIFY_LIBRARY_ON_START=true

# Dati mostrati nell'interfaccia
APP_DISPLAY_NAME=Baia Cinghiala
APP_UI_VERSION=2.0
PROFILE_NAME=Peru

# Backup automatici del database SQLite sull'SSD del server.
DATABASE_BACKUPS_PATH=./data/backups
DATABASE_DAILY_BACKUP_RETENTION=50
DATABASE_MONTHLY_BACKUP_RETENTION=12

# Cache ricostruibile delle copertine. Le copie principali restano accanto ai contenuti sul RAID.
METADATA_POSTER_CACHE_PATH=./data/cache/posters

# Cache ricostruibile delle copertine incorporate negli album musicali.
# La fonte primaria resta il tag del file MP3/FLAC/WAV.
MUSIC_COVER_CACHE_PATH=./data/cache/music-covers

# Baia Direct Internet (pairing bootstrap; nessun segreto server)
# Endpoint pubblico/DDNS raggiungibile dal client tramite router TCP 443 -> Connector:43127.
# BAIA_PUBLIC_CONNECTOR_ENDPOINT=https://baia-host.example-ddns.net:443
# Fingerprint pubblica stampata dal Baia Host Connector.
# BAIA_CONNECTOR_SERVER_FINGERPRINT=SHA256:...
