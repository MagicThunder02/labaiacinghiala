{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baia Cinghiala",
  "version": "0.6.1",
  "identifier": "it.baia.cinghiala",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://localhost:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Baia Cinghiala",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/libmpv/*.dll": "libmpv/",
      "resources/mpv/*.lua": "mpv/"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MagicThunder02/labaiacinghiala/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBNDk0ODQ3MTAyQzYyMzgKUldRNFlpd1FSMGhKS3B0V2JxdkVidnBwYkZma2tmNVRnUWtFeXZuYk56V04yb1hlNStFTlM3enMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
